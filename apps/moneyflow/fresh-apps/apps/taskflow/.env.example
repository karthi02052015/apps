# ---------------------------------------------------------------------------
# TaskFlow configuration. Copy to .env (root, for docker compose) or
# apps/api/.env (for `npm run dev`). NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# PostgreSQL connection. Leave empty in development to use the embedded database.
DATABASE_URL=
# Used by docker-compose for the bundled Postgres container.
POSTGRES_PASSWORD=

# --- Server -----------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# Comma-separated list of allowed browser origins.
# CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
# TRUST_PROXY=0
# Defaults to true in production. Only set false for plain-http local testing.
# COOKIE_SECURE=
# LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# Apply migrations at boot (disable for multi-replica deploys; run db:migrate as a release step).
# AUTO_MIGRATE=true
# Embedded dev database location (ignored when DATABASE_URL is set).
# PGLITE_DATA_DIR=./.data/pglite

# --- Auth -------------------------------------------------------------------
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting ----------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# --- Scheduler (reminders / overdue alerts / housekeeping) ------------------
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_MS=30000

# --- Observability ----------------------------------------------------------
# When set, GET /metrics requires "Authorization: Bearer <token>".
# METRICS_TOKEN=

# --- Single-container mode --------------------------------------------------
# Serve the built web app from the API (set automatically in the Docker image).
# WEB_DIST_DIR=../web/dist
