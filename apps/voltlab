<script>
/* NAVIGATION */
const pages=[...document.querySelectorAll(".tool-page")];
const navs=[...document.querySelectorAll(".nav[data-page]")];
const title=document.getElementById("pageTitle");

const titles={
 dashboard:"Dashboard",
 scientific:"Scientific Calculator",
 ohm:"Ohm's Law",
 power:"Power Calculator",
 resistor:"Resistor Color Code",
 led:"LED Resistor",
 divider:"Voltage Divider",
 series:"Series / Parallel",
 capacitor:"Capacitor Calculator",
 rc:"RC Time Constant",
 converter:"Unit Converter",
 logic:"Logic Gates",
 reference:"Electronics Reference"
};

function openPage(page){
  pages.forEach(p=>p.classList.toggle("active",p.id===page));
  navs.forEach(n=>n.classList.toggle("active",n.dataset.page===page));
  title.textContent=titles[page]||page;
  document.getElementById("sidebar").classList.remove("open");
  history.replaceState(null,"","#"+page);
}

navs.forEach(n=>n.addEventListener("click",()=>openPage(n.dataset.page)));

document.querySelectorAll("[data-open]").forEach(c=>{
  c.addEventListener("click",()=>openPage(c.dataset.open));
});

document.getElementById("menuBtn").onclick=()=>{
  document.getElementById("sidebar").classList.toggle("open");
};

/* THEME */
function toggleTheme(){
  document.body.classList.toggle("light");
  localStorage.setItem("electrolab-theme",
    document.body.classList.contains("light")?"light":"dark");
}
document.getElementById("themeBtn").onclick=toggleTheme;
document.getElementById("themeTop").onclick=toggleTheme;

if(localStorage.getItem("electrolab-theme")==="light")
  document.body.classList.add("light");

/* OHM */
function ohmModeChange(){
  const m=document.getElementById("ohmMode").value;
  const el=document.getElementById("ohmInputs");

  if(m==="I"){
    el.innerHTML=`
      <div class="field"><label>Voltage (V)</label>
      <input id="ov" type="number" value="12"></div>
      <div class="field"><label>Resistance (Ω)</label>
      <input id="or" type="number" value="1000"></div>`;
  }
  if(m==="V"){
    el.innerHTML=`
      <div class="field"><label>Current (A)</label>
      <input id="oi" type="number" value="0.01"></div>
      <div class="field"><label>Resistance (Ω)</label>
      <input id="or" type="number" value="1000"></div>`;
  }
  if(m==="R"){
    el.innerHTML=`
      <div class="field"><label>Voltage (V)</label>
      <input id="ov" type="number" value="12"></div>
      <div class="field"><label>Current (A)</label>
      <input id="oi" type="number" value="0.01"></div>`;
  }
}
ohmModeChange();

function fmt(n){
  if(!isFinite(n))return "Invalid";
  const a=Math.abs(n);
  if(a>=1e9)return (n/1e9).toFixed(3)+" G";
  if(a>=1e6)return (n/1e6).toFixed(3)+" M";
  if(a>=1e3)return (n/1e3).toFixed(3)+" k";
  if(a<1 && a>=1e-3)return (n*1e3).toFixed(3)+" m";
  if(a<1e-3)return n.toExponential(3);
  return Number(n.toFixed(4)).toString();
}

function calcOhm(){
  const m=document.getElementById("ohmMode").value;
  let result;

  if(m==="I"){
    const v=+document.getElementById("ov").value;
    const r=+document.getElementById("or").value;
    result=v/r;
    document.getElementById("ohmResult").textContent=fmt(result)+" A";
    document.getElementById("ohmDetails").textContent=`I = ${v} / ${r}`;
  }

  if(m==="V"){
    const i=+document.getElementById("oi").value;
    const r=+document.getElementById("or").value;
    result=i*r;
    document.getElementById("ohmResult").textContent=fmt(result)+" V";
    document.getElementById("ohmDetails").textContent=`V = ${i} × ${r}`;
  }

  if(m==="R"){
    const v=+document.getElementById("ov").value;
    const i=+document.getElementById("oi").value;
    result=v/i;
    document.getElementById("ohmResult").textContent=fmt(result)+" Ω";
    document.getElementById("ohmDetails").textContent=`R = ${v} / ${i}`;
  }
}

/* POWER */
function powerCalc(){
  let v=+powerV.value;
  let i=+powerI.value;
  if(powerVU.value==="mV")v/=1000;
  if(powerIU.value==="mA")i/=1000;

  const p=v*i;
  powerResult.textContent=fmt(p)+" W";
  powerDetails.textContent=
    `P = ${v} × ${i} = ${p} W`;
}

/* RESISTOR COLORS */
const colors=[
 ["Black",0,"black"],
 ["Brown",1,"brown"],
 ["Red",2,"red"],
 ["Orange",3,"orange"],
 ["Yellow",4,"yellow"],
 ["Green",5,"green"],
 ["Blue",6,"blue"],
 ["Violet",7,"violet"],
 ["Grey",8,"grey"],
 ["White",9,"white"]
];

const tolerances=[
 ["Gold","±5%","gold"],
 ["Silver","±10%","silver"],
 ["Brown","±1%","brown"],
 ["Red","±2%","red"]
];

function fillResistors(){
  ["r1","r2"].forEach(id=>{
    const s=document.getElementById(id);
    s.innerHTML=colors.map(c=>
      `<option value="${c[1]}">${c[0]}</option>`).join("");
  });

  r3.innerHTML=colors.map(c=>
    `<option value="${c[1]}">${c[0]} ×10^${c[1]}</option>`).join("");

  r4.innerHTML=tolerances.map((c,i)=>
    `<option value="${i}">${c[0]} ${c[1]}</option>`).join("");

  r1.value=1;
  r2.value=0;
  r3.value=2;
  r4.value=0;
}
fillResistors();

function resistorCalc(){
  const a=+r1.value,b=+r2.value,m=+r3.value;
  const t=tolerances[+r4.value];

  const resistance=(10*a+b)*Math.pow(10,m);

  let val;
  if(resistance>=1e6)val=(resistance/1e6).toFixed(2)+" MΩ";
  else if(resistance>=1000)val=(resistance/1000).toFixed(2)+" kΩ";
  else val=resistance+" Ω";

  resistorResult.textContent=val+" "+t[1];

  rb1.className="band b1 "+colors[a][2];
  rb2.className="band b2 "+colors[b][2];
  rb3.className="band b3 "+colors[m][2];
  rb4.className="band b4 "+t[2];
}
resistorCalc();

function randomResistor(){
  r1.value=Math.floor(Math.random()*10);
  r2.value=Math.floor(Math.random()*10);
  r3.value=Math.floor(Math.random()*10);
  r4.value=Math.floor(Math.random()*4);
  resistorCalc();
}

/* LED */
function ledCalc(){
  const v=+ledV.value;
  const vf=+ledF.value;
  const ma=+ledI.value;
  const i=ma/1000;

  const r=(v-vf)/i;
  const p=i*i*r;

  if(r<=0){
    ledResult.textContent="Invalid";
    ledPower.textContent="Supply voltage must exceed LED forward voltage.";
    return;
  }

  ledResult.textContent=fmt(r)+" Ω";
  ledPower.textContent=
    `Resistor power = ${p.toFixed(3)} W — use at least a ${Math.ceil(p*2*100)/100} W rated resistor.`;
}

/* VOLTAGE DIVIDER */
function dividerCalc(){
  const v=+divV.value;
  const r1=+divR1.value;
  const r2=+divR2.value;

  const out=v*r2/(r1+r2);
  const current=v/(r1+r2);

  dividerResult.textContent=out.toFixed(4)+" V";
  dividerCurrent.textContent=
    `Divider current: ${fmt(current)} A`;
}

/* SERIES/PARALLEL */
function seriesCalc(){
  const vals=resValues.value.split(",")
    .map(x=>parseFloat(x.trim()))
    .filter(x=>x>0);

  if(!vals.length){
    seriesResult.textContent="Invalid";
    return;
  }

  let total;

  if(seriesMode.value==="series"){
    total=vals.reduce((a,b)=>a+b,0);
    seriesFormula.textContent=
      "Rtotal = R1 + R2 + ...";
  }else{
    total=1/vals.reduce((a,b)=>a+1/b,0);
    seriesFormula.textContent=
      "1/Rtotal = 1/R1 + 1/R2 + ...";
  }

  seriesResult.textContent=fmt(total)+" Ω";
}

/* CAPACITOR */
function capCalc(){
  const c=+capC.value*+capU.value;
  const v=+capV.value;

  const q=c*v;
  const e=.5*c*v*v;

  capCharge.textContent=fmt(q)+" C";
  capEnergy.textContent=fmt(e)+" J";
}

/* RC */
function rcCalc(){
  const r=+rcR.value;
  const c=+rcC.value*1e-6;

  const tau=r*c;

  rcResult.textContent=fmt(tau)+" s";
  rcTimes.innerHTML=
    `1τ: ${(tau).toFixed(4)} s<br>
     3τ: ${(3*tau).toFixed(4)} s<br>
     5τ: ${(5*tau).toFixed(4)} s`;
}

/* CONVERTER */
const units=[
 ["Ω",1,"Resistance"],
 ["kΩ",1000,"Resistance"],
 ["MΩ",1000000,"Resistance"],
 ["V",1,"Voltage"],
 ["mV",0.001,"Voltage"],
 ["A",1,"Current"],
 ["mA",0.001,"Current"],
 ["W",1,"Power"],
 ["mW",0.001,"Power"],
 ["F",1,"Capacitance"],
 ["µF",1e-6,"Capacitance"],
 ["nF",1e-9,"Capacitance"],
 ["pF",1e-12,"Capacitance"],
 ["Hz",1,"Frequency"],
 ["kHz",1000,"Frequency"],
 ["MHz",1000000,"Frequency"]
];

function initConverter(){
  const html=units.map((u,i)=>
    `<option value="${i}">${u[0]}</option>`).join("");
  convFrom.innerHTML=html;
  convTo.innerHTML=html;
  convFrom.value=0;
  convTo.value=1;
}
initConverter();

function convert(){
  const a=units[+convFrom.value];
  const b=units[+convTo.value];

  if(a[2]!==b[2]){
    convResult.textContent="Units are incompatible";
    return;
  }

  const value=+convValue.value;
  const base=value*a[1];
  const result=base/b[1];

  convResult.textContent=
    `${result} ${b[0]}`;
}

/* SCIENTIFIC CALCULATOR */
let calcExpr="";

function calcRender(){
  calcExpression.textContent=calcExpr;
  calcValue.textContent=calcExpr||"0";
}

function calcInsert(x){
  calcExpr+=x;
  calcRender();
}

function calcClear(){
  calcExpr="";
  calcRender();
}

function calcBack(){
  calcExpr=calcExpr.slice(0,-1);
  calcRender();
}

function calcEvaluate(){
  try{
    let e=calcExpr
      .replace(/sin\(/g,"Math.sin(")
      .replace(/cos\(/g,"Math.cos(")
      .replace(/tan\(/g,"Math.tan(")
      .replace(/sqrt\(/g,"Math.sqrt(")
      .replace(/log\(/g,"Math.log10(");

    if(!/^[0-9+\-*/().,\sA-Za-z_]+$/.test(e))
      throw Error();

    const result=Function(
      "return ("+e+")"
    )();

    calcExpression.textContent=calcExpr;
    calcValue.textContent=
      Number.isFinite(result)
      ? Number(result.toFixed(12))
      : "Error";

    calcExpr=String(result);
  }catch{
    calcValue.textContent="Error";
  }
}

/* KEYBOARD CALCULATOR */
document.addEventListener("keydown",e=>{
  if(document.getElementById("scientific").classList.contains("active")){
    if(/[0-9+\-*/().]/.test(e.key))calcInsert(e.key);
    if(e.key==="Enter")calcEvaluate();
    if(e.key==="Backspace")calcBack();
    if(e.key==="Escape")calcClear();
  }
});

/* HASH ROUTING */
if(location.hash){
  const p=location.hash.substring(1);
  if(document.getElementById(p))openPage(p);
}
</script>
