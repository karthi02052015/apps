<!-- REFERENCE -->
<section class="tool-page" id="reference">
  <div class="page-head">
    <h1>Electronics Reference</h1>
    <p>Quick formulas for everyday electronics work.</p>
  </div>

  <div class="cards">
    <div class="tool-card">
      <div class="tool-icon">Ω</div>
      <h3>Ohm's Law</h3>
      <p>V = IR<br>I = V/R<br>R = V/I</p>
    </div>
    <div class="tool-card">
      <div class="tool-icon">⚡</div>
      <h3>Power</h3>
      <p>P = VI<br>P = I²R<br>P = V²/R</p>
    </div>
    <div class="tool-card">
      <div class="tool-icon">▥</div>
      <h3>Capacitor</h3>
      <p>Q = CV<br>E = ½CV²</p>
    </div>
    <div class="tool-card">
      <div class="tool-icon">◉</div>
      <h3>RC Circuit</h3>
      <p>τ = RC<br>After 1τ ≈ 63.2%</p>
    </div>
    <div class="tool-card">
      <div class="tool-icon">↕</div>
      <h3>Voltage Divider</h3>
      <p>Vout = Vin × R2/(R1+R2)</p>
    </div>
