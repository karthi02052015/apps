<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Offline JSON / JWT Quick Formatter & Inspector" />
  <title>JSON / JWT Quick Formatter & Inspector</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #080b12;
      --panel: #10151f;
      --panel-2: #151c28;
      --border: #273142;
      --text: #e6edf7;
      --muted: #8b98aa;
      --accent: #6ea8fe;
      --accent-2: #4f8df7;
      --green: #35d07f;
      --red: #ff5c70;
      --yellow: #f5c451;
      --purple: #b18cff;
      --shadow: 0 20px 60px rgba(0, 0, 0, .35);
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      background:
        radial-gradient(circle at top left, rgba(76, 110, 245, .09), transparent 30%),
        radial-gradient(circle at bottom right, rgba(177, 140, 255, .06), transparent 30%),
        var(--bg);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    body {
      padding: 24px;
    }

    button,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      width: min(1400px, 100%);
      margin: 0 auto;
    }

    /* Header */

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #1d4ed8, #7c3aed);
      box-shadow: 0 10px 30px rgba(79, 70, 229, .25);
      font-size: 22px;
      font-weight: 800;
    }

    h1 {
      margin: 0;
      font-size: clamp(20px, 3vw, 28px);
      letter-spacing: -.6px;
    }

    .subtitle {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .offline-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 1px solid rgba(53, 208, 127, .25);
      color: #7de8aa;
      background: rgba(53, 208, 127, .07);
      border-radius: 999px;
      padding: 7px 11px;
      font-size: 12px;
      white-space: nowrap;
    }

    .offline-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 10px rgba(53, 208, 127, .8);
    }

    /* Panels */

    .panel {
      background: rgba(16, 21, 31, .92);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .panel-header {
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
    }

    .panel-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-weight: 700;
      font-size: 14px;
    }

    .panel-title span {
      color: var(--muted);
      font-weight: 500;
      font-size: 12px;
    }

    /* Input */

    .input-panel {
      margin-bottom: 18px;
    }

    .editor-wrap {
      position: relative;
    }

    #input {
      display: block;
      width: 100%;
      min-height: 280px;
      resize: vertical;
      border: 0;
      outline: none;
      background: #0b1018;
      color: #dce7f5;
      padding: 20px;
      font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        Menlo,
        monospace;
      font-size: 14px;
      line-height: 1.65;
      tab-size: 2;
    }

    #input::placeholder {
      color: #536176;
    }

    .editor-footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 10px 14px;
      background: #0b1018;
      border-top: 1px solid #1d2635;
    }

    .detector {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .detector strong {
      color: var(--text);
    }

    .mode-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
    }

    .mode-dot.jwt {
      background: var(--purple);
      box-shadow: 0 0 10px rgba(177, 140, 255, .6);
    }

    .mode-dot.json {
      background: var(--accent);
      box-shadow: 0 0 10px rgba(110, 168, 254, .6);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn {
      border: 1px solid var(--border);
      background: #151c28;
      color: #dbe5f2;
      border-radius: 9px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 650;
      transition:
        background .15s ease,
        border-color .15s ease,
        transform .15s ease;
    }

    .btn:hover {
      background: #1c2635;
      border-color: #3a4659;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn.primary {
      background: #1d4ed8;
      border-color: #2861e6;
      color: white;
    }

    .btn.primary:hover {
      background: #245be2;
    }

    .btn.danger {
      color: #ff8593;
    }

    /* Status */

    .status {
      display: none;
      margin: 0 0 18px;
      padding: 12px 15px;
      border: 1px solid;
      border-radius: 12px;
      font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
      font-size: 12px;
      line-height: 1.5;
    }

    .status.visible {
      display: block;
    }

    .status.error {
      color: #ff9ca9;
      border-color: rgba(255, 92, 112, .3);
      background: rgba(255, 92, 112, .07);
    }

    .status.success {
      color: #8be9b2;
      border-color: rgba(53, 208, 127, .3);
      background: rgba(53, 208, 127, .07);
    }

    /* Results */

    .results {
      display: grid;
      gap: 18px;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .code-card {
      min-width: 0;
      background: #0b1018;
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
    }

    .code-card-header {
      min-height: 46px;
      padding: 10px 13px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid var(--border);
      background: #111722;
    }

    .code-card-title {
      font-size: 12px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: .7px;
    }

    .code-card-meta {
      color: var(--muted);
      font-size: 11px;
      font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
    }

    pre {
      margin: 0;
      min-height: 180px;
      max-height: 520px;
      overflow: auto;
      padding: 16px;
      color: #dce7f5;
      font-family:
        "SFMono-Regular",
        Consolas,
        "Liberation Mono",
        Menlo,
        monospace;
      font-size: 13px;
      line-height: 1.65;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* JWT */

    #jwtSection {
      display: none;
    }

    #jwtSection.visible {
      display: block;
    }

    .jwt-top {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }

    .token-status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 16px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #0b1018;
    }

    .token-state {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .state-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      font-weight: 900;
      font-size: 17px;
    }

    .state-valid .state-icon {
      background: rgba(53, 208, 127, .12);
      color: var(--green);
    }

    .state-expired .state-icon {
      background: rgba(255, 92, 112, .12);
      color: var(--red);
    }

    .state-future .state-icon {
      background: rgba(245, 196, 81, .12);
      color: var(--yellow);
    }

    .state-unknown .state-icon {
      background: rgba(139, 152, 170, .12);
      color: var(--muted);
    }

    .state-label {
      font-weight: 800;
      font-size: 15px;
    }

    .state-description {
      margin-top: 3px;
      color: var(--muted);
      font-size: 11px;
    }

    .clock {
      color: var(--muted);
      font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
      font-size: 11px;
      text-align: right;
    }

    .claims {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .claim {
      border: 1px solid var(--border);
      background: #0b1018;
      border-radius: 11px;
      padding: 12px;
      min-width: 0;
    }

    .claim-name {
      color: var(--muted);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .5px;
    }

    .claim-value {
      margin-top: 6px;
      font-family:
        "SFMono-Regular",
        Consolas,
        monospace;
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    /* Collapsible */

    details {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #0b1018;
      overflow: hidden;
    }

    details + details {
      margin-top: 12px;
    }

    summary {
      cursor: pointer;
      padding: 13px 15px;
      font-size: 13px;
      font-weight: 750;
      background: #111722;
      user-select: none;
    }

    summary:hover {
      background: #151d2a;
    }

    details pre {
      border-top: 1px solid var(--border);
    }

    /* Empty */

    .empty {
      text-align: center;
      padding: 45px 20px;
      color: var(--muted);
    }

    .empty-icon {
      font-size: 30px;
      margin-bottom: 10px;
      opacity: .7;
    }

    .empty strong {
      display: block;
      color: #cbd5e1;
      margin-bottom: 5px;
    }

    .empty p {
      margin: 0;
      font-size: 12px;
    }

    /* Toast */

    #toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      transform: translate(-50%, 20px);
      padding: 10px 15px;
      border-radius: 10px;
      background: #182231;
      border: 1px solid #344158;
      color: white;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 15px 40px rgba(0, 0, 0, .4);
      opacity: 0;
      pointer-events: none;
      transition: all .2s ease;
      z-index: 999;
    }

    #toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    /* Footer */

    footer {
      margin-top: 20px;
      color: #566378;
      text-align: center;
      font-size: 11px;
    }

    footer code {
      color: #77859a;
      font-family: monospace;
    }

    /* Scrollbars */

    ::-webkit-scrollbar {
      width: 9px;
      height: 9px;
    }

    ::-webkit-scrollbar-track {
      background: #0a0e15;
    }

    ::-webkit-scrollbar-thumb {
      background: #273142;
      border-radius: 999px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #344158;
    }

    /* Responsive */

    @media (max-width: 850px) {
      body {
        padding: 13px;
      }

      .header {
        align-items: flex-start;
      }

      .offline-badge {
        display: none;
      }

      .result-grid,
      .claims {
        grid-template-columns: 1fr;
      }

      #input {
        min-height: 230px;
      }

      .token-status {
        align-items: flex-start;
        flex-direction: column;
      }

      .clock {
        text-align: left;
      }
    }

    @media (max-width: 500px) {
      .panel-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .editor-footer {
        align-items: flex-start;
        flex-direction: column;
      }

      .actions {
        width: 100%;
      }

      .btn {
        flex: 1;
      }
    }
  </style>

