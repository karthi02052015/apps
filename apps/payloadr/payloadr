<script>
"use strict";

/*
  JSON / JWT Quick Formatter & Inspector
  --------------------------------------
  Fully client-side.
  No fetch(), XMLHttpRequest, WebSocket or external resources.
*/

/* -------------------------------------------------------
   DOM
------------------------------------------------------- */

const input = document.getElementById("input");

const formatBtn = document.getElementById("formatBtn");
const minifyBtn = document.getElementById("minifyBtn");
const copyBtn = document.getElementById("copyBtn");
const clearBtn = document.getElementById("clearBtn");

const modeDot = document.getElementById("modeDot");
const modeText = document.getElementById("modeText");

const status = document.getElementById("status");
const jsonSection = document.getElementById("jsonSection");
const jsonOutput = document.getElementById("jsonOutput");

const jwtSection = document.getElementById("jwtSection");

const jwtHeader = document.getElementById("jwtHeader");
const jwtPayload = document.getElementById("jwtPayload");
const jwtSignature = document.getElementById("jwtSignature");

const tokenStatus = document.getElementById("tokenStatus");
const stateLabel = document.getElementById("stateLabel");
const stateDescription = document.getElementById("stateDescription");
const clock = document.getElementById("clock");
const claims = document.getElementById("claims");

const toast = document.getElementById("toast");


/* -------------------------------------------------------
   Helpers
------------------------------------------------------- */

function getInput() {
  return input.value.trim();
}

function isLikelyJWT(value) {
  const parts = value.split(".");

  if (parts.length !== 3) {
    return false;
  }

  /*
    JWT Base64URL segments may contain:
    A-Z a-z 0-9 - _
  */
  return parts.every(function(part) {
    return /^[A-Za-z0-9_-]+$/.test(part);
  });
}

function showStatus(message, type) {
  status.textContent = message;
  status.className = "status visible " + type;
}

function hideStatus() {
  status.textContent = "";
  status.className = "status";
}

function showToast(message = "Copied!") {
  toast.textContent = message;
  toast.classList.add("show");

  clearTimeout(showToast.timer);

  showToast.timer = setTimeout(function() {
    toast.classList.remove("show");
  }, 1500);
}


/* -------------------------------------------------------
   JSON Error Location
------------------------------------------------------- */

function getJSONErrorPosition(error, source) {
  const message = String(error && error.message || "");

  /*
    Chrome / Edge:
      Unexpected token } in JSON at position 17

    Firefox:
      JSON.parse: unexpected character at line 2 column 3
  */

  let line = null;
  let column = null;
  let position = null;

  const positionMatch = message.match(/position\s+(\d+)/i);

  if (positionMatch) {
    position = Number(positionMatch[1]);

    const before = source.slice(0, position);

    line = before.split("\n").length;

    const lastNewLine = before.lastIndexOf("\n");

    column =
      position -
      (lastNewLine === -1 ? 0 : lastNewLine + 1) +
      1;
  }

  const lineColumnMatch =
    message.match(/line\s+(\d+)\s+column\s+(\d+)/i);

  if (lineColumnMatch) {
    line = Number(lineColumnMatch[1]);
    column = Number(lineColumnMatch[2]);
  }

  return {
    line,
    column,
    position,
    message
  };
}


/* -------------------------------------------------------
   JSON Parsing
------------------------------------------------------- */

function parseJSON(value) {
  try {
    return {
      success: true,
      data: JSON.parse(value)
    };
  } catch (error) {
    return {
      success: false,
      error: getJSONErrorPosition(error, value)
    };
  }
}

function prettyJSON(data) {
  return JSON.stringify(data, null, 2);
}

function compactJSON(data) {
  return JSON.stringify(data);
}


/* -------------------------------------------------------
   Base64URL decoding
------------------------------------------------------- */

function base64UrlToBytes(base64url) {

  let base64 = base64url
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  while (base64.length % 4 !== 0) {
    base64 += "=";
  }

  const binary = atob(base64);

  const bytes = new Uint8Array(binary.length);

  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

function decodeBase64URL(base64url) {

  const bytes = base64UrlToBytes(base64url);

  /*
    TextDecoder correctly handles UTF-8 JWT payloads.
  */
  return new TextDecoder("utf-8", {
    fatal: true
  }).decode(bytes);
}

function decodeJWTSegment(segment) {

  const text = decodeBase64URL(segment);

  return JSON.parse(text);
}


/* -------------------------------------------------------
   Timestamp formatting
------------------------------------------------------- */

function formatTimestamp(value) {

  if (
    typeof value !== "number" ||
    !Number.isFinite(value)
  ) {
    return String(value);
  }

  const date = new Date(value * 1000);

  if (Number.isNaN(date.getTime())) {
    return String(value);
  }

  return date.toLocaleString(undefined, {
    dateStyle: "medium",
    timeStyle: "medium"
  });
}


/* -------------------------------------------------------
   JWT Claims
------------------------------------------------------- */

function renderClaim(name, value) {

  const wrapper = document.createElement("div");
  wrapper.className = "claim";

  const title = document.createElement("div");
  title.className = "claim-name";
  title.textContent = name;

  const valueElement = document.createElement("div");
  valueElement.className = "claim-value";

  if (
    ["iat", "exp", "nbf"].includes(name) &&
    typeof value === "number"
  ) {
    valueElement.textContent =
      value + " → " + formatTimestamp(value);
  } else if (
    typeof value === "object" &&
    value !== null
  ) {
    valueElement.textContent =
      JSON.stringify(value);
  } else {
    valueElement.textContent =
      String(value);
  }

  wrapper.appendChild(title);
  wrapper.appendChild(valueElement);

  return wrapper;
}

function renderClaims(payload) {

  claims.innerHTML = "";

  const importantClaims = [
    "iss",
    "sub",
    "aud",
    "iat",
    "nbf",
    "exp"
  ];

  let count = 0;

  importantClaims.forEach(function(name) {

    if (
      Object.prototype.hasOwnProperty.call(payload, name)
    ) {
      claims.appendChild(
        renderClaim(name, payload[name])
      );

      count++;
    }
  });

  /*
    If none of the standard claims exist,
    display a few custom claims instead.
  */

  if (count === 0) {

    Object.keys(payload)
      .slice(0, 6)
      .forEach(function(name) {

        claims.appendChild(
          renderClaim(name, payload[name])
        );

      });
  }
}


/* -------------------------------------------------------
   JWT Status
------------------------------------------------------- */

function updateJWTStatus(payload) {

  tokenStatus.className = "token-status";

  const now = Math.floor(Date.now() / 1000);

  let state = "unknown";
  let label = "Status unknown";
  let description =
    "No usable exp/nbf timing claims were found.";

  /*
    nbf = Not Before
    exp = Expiration Time

    Standard interpretation:
      now < nbf  => Not Yet Active
      now >= exp => Expired
      otherwise  => Valid
  */

  if (
    typeof payload.nbf === "number" &&
    now < payload.nbf
  ) {

    state = "future";
    label = "Not Yet Active";

    description =
      "The token's nbf claim is in the future.";

  } else if (
    typeof payload.exp === "number" &&
    now >= payload.exp
  ) {

    state = "expired";
    label = "Expired";

    description =
      "The token's exp claim is in the past.";

  } else if (
    typeof payload.exp === "number" ||
    typeof payload.nbf === "number"
  ) {

    state = "valid";
    label = "Valid";

    description =
      "The token is currently within its available time window.";

  }

  tokenStatus.classList.add(
    "state-" + state
  );

  const icon =
    tokenStatus.querySelector(".state-icon");

  icon.textContent =
    state === "valid" ? "✓" :
    state === "expired" ? "!" :
    state === "future" ? "⏳" :
    "?";

  stateLabel.textContent = label;
  stateDescription.textContent = description;

  clock.textContent =
    "System time: " +
    new Date().toLocaleString();
}


/* -------------------------------------------------------
   JWT Processing
------------------------------------------------------- */

function processJWT(value) {

  const parts = value.split(".");

  if (parts.length !== 3) {
    throw new Error(
      "A JWT must contain exactly 3 dot-separated segments."
    );
  }

  let header;
  let payload;

  try {
    header = decodeJWTSegment(parts[0]);
  } catch (error) {
    throw new Error(
      "Unable to decode JWT header: " +
      error.message
    );
  }

  try {
    payload = decodeJWTSegment(parts[1]);
  } catch (error) {
    throw new Error(
      "Unable to decode JWT payload: " +
      error.message
    );
  }

  jwtHeader.textContent =
    prettyJSON(header);

  jwtPayload.textContent =
    prettyJSON(payload);

  jwtSignature.textContent =
    parts[2] || "(empty signature segment)";

  renderClaims(payload);

  updateJWTStatus(payload);

  jwtSection.classList.add("visible");
  jsonSection.style.display = "none";

  showStatus(
    "JWT decoded successfully. Decoding is performed locally.",
    "success"
  );
}


/* -------------------------------------------------------
   JSON Processing
------------------------------------------------------- */

function processJSON(mode) {

  const value = getInput();

  const parsed = parseJSON(value);

  if (!parsed.success) {

    const e = parsed.error;

    let message =
      "Invalid JSON.";

    if (
      e.line !== null &&
      e.column !== null
    ) {
      message +=
        " Error at line " +
        e.line +
        ", column " +
        e.column + ".";
    }

    if (
      e.position !== null
    ) {
      message +=
        " Character position: " +
        e.position + ".";
    }

    message +=
      " " +
      e.message;

    showStatus(message, "error");

    jwtSection.classList.remove("visible");
    jsonSection.style.display = "block";

    jsonOutput.innerHTML = `
      <div class="empty">
        <div class="empty-icon">⚠</div>
        <strong>Malformed JSON</strong>
        <p>Correct the syntax above and try again.</p>
      </div>
    `;

    return;
  }

  const output =
    mode === "minify"
      ? compactJSON(parsed.data)
      : prettyJSON(parsed.data);

  /*
    Put the formatted result back into the input.
    This makes the tool behave like a formatter.
  */
  input.value = output;

  renderJSONOutput(output);

  jwtSection.classList.remove("visible");
  jsonSection.style.display = "block";

  showStatus(
    mode === "minify"
      ? "JSON compacted successfully."
      : "JSON formatted successfully.",
    "success"
  );

  detectMode();
}

function renderJSONOutput(text) {

  const card = document.createElement("div");
  card.className = "code-card";

  const header = document.createElement("div");
  header.className = "code-card-header";

  const title = document.createElement("div");
  title.className = "code-card-title";
  title.textContent = "Formatted JSON";

  const meta = document.createElement("div");
  meta.className = "code-card-meta";
  meta.textContent =
    text.length.toLocaleString() + " chars";

  header.appendChild(title);
  header.appendChild(meta);

  const pre = document.createElement("pre");
  pre.textContent = text;

  card.appendChild(header);
  card.appendChild(pre);

  jsonOutput.innerHTML = "";
  jsonOutput.appendChild(card);
}


/* -------------------------------------------------------
   Auto Detection
------------------------------------------------------- */

function detectMode() {

  const value = getInput();

  modeDot.className = "mode-dot";

  if (!value) {

    modeText.textContent =
      "Waiting for input";

    jsonSection.style.display = "block";
    jwtSection.classList.remove("visible");

    return;
  }

  if (isLikelyJWT(value)) {

    modeDot.classList.add("jwt");
    modeText.textContent =
      "JWT";

    return;
  }

  /*
    Check if it looks like JSON.
  */

  const first = value[0];

  if (
    first === "{" ||
    first === "["
  ) {

    modeDot.classList.add("json");

    modeText.textContent =
      "JSON";

    return;
  }

  modeText.textContent =
    "Text / unknown";
}


/* -------------------------------------------------------
   Automatic processing
------------------------------------------------------- */

let detectTimer = null;

input.addEventListener("input", function() {

  detectMode();

  clearTimeout(detectTimer);

  /*
    Automatically inspect JWTs once typing/pasting
    settles. JSON is not automatically reformatted,
    preventing the cursor from jumping while typing.
  */

  detectTimer = setTimeout(function() {

    const value = getInput();

    if (!value) {
      return;
    }

    if (isLikelyJWT(value)) {

      try {
        processJWT(value);
      } catch (error) {
        showStatus(
          error.message,
          "error"
        );
      }

    }

  }, 250);
});


/* -------------------------------------------------------
   Buttons
------------------------------------------------------- */

formatBtn.addEventListener("click", function() {

  const value = getInput();

  if (!value) {
    showStatus(
      "Paste JSON or a JWT first.",
      "error"
    );
    return;
  }

  if (isLikelyJWT(value)) {

    try {
      processJWT(value);
    } catch (error) {
      showStatus(
        error.message,
        "error"
      );
    }

    return;
  }

  processJSON("format");
});


minifyBtn.addEventListener("click", function() {

  const value = getInput();

  if (!value) {
    showStatus(
      "Paste JSON first.",
      "error"
    );
    return;
  }

  if (isLikelyJWT(value)) {

    showStatus(
      "Minify / Compact is intended for JSON. JWT segments are already compact.",
      "error"
    );

    return;
  }

  processJSON("minify");
});


copyBtn.addEventListener("click", async function() {

  const value = getInput();

  if (!value) {
    showStatus(
      "Nothing to copy.",
      "error"
    );
    return;
  }

  try {

    await navigator.clipboard.writeText(value);

    showToast("Copied!");

  } catch (error) {

    /*
      Fallback for browsers where Clipboard API
      is unavailable.
    */

    input.focus();
    input.select();

    try {

      document.execCommand("copy");

      showToast("Copied!");

    } catch (fallbackError) {

      showStatus(
        "Clipboard access was blocked by the browser.",
        "error"
      );
    }
  }
});


clearBtn.addEventListener("click", function() {

  input.value = "";

  modeDot.className = "mode-dot";
  modeText.textContent =
    "Waiting for input";

  hideStatus();

  jwtSection.classList.remove("visible");
  jsonSection.style.display = "block";

  jsonOutput.innerHTML = `
    <div class="empty">
      <div class="empty-icon">{ }</div>
      <strong>No JSON processed yet</strong>
      <p>Paste JSON above to format or compact it.</p>
    </div>
  `;

  claims.innerHTML = "";

  input.focus();
});


/* -------------------------------------------------------
   Keyboard shortcuts
------------------------------------------------------- */

input.addEventListener("keydown", function(event) {

  /*
    Ctrl/Cmd + Enter:
      Process current input.
  */

  if (
    event.key === "Enter" &&
    (event.ctrlKey || event.metaKey)
  ) {

    event.preventDefault();

    const value = getInput();

    if (!value) {
      return;
    }

    if (isLikelyJWT(value)) {

      try {
        processJWT(value);
      } catch (error) {
        showStatus(
          error.message,
          "error"
        );
      }

    } else {
      processJSON("format");
    }
  }

  /*
    Tab inserts two spaces instead of leaving textarea.
  */

  if (event.key === "Tab") {

    event.preventDefault();

    const start = input.selectionStart;
    const end = input.selectionEnd;

    input.value =
      input.value.substring(0, start) +
      "  " +
      input.value.substring(end);

    input.selectionStart =
      input.selectionEnd =
      start + 2;
  }

});


/* -------------------------------------------------------
   Clock refresh
------------------------------------------------------- */

setInterval(function() {

  if (
    jwtSection.classList.contains("visible")
  ) {

    const value = getInput();

    if (isLikelyJWT(value)) {

      try {

        const parts = value.split(".");
        const payload =
          decodeJWTSegment(parts[1]);

        updateJWTStatus(payload);

      } catch (_) {
        // Ignore clock refresh errors.
      }
    }
  }

}, 1000);


/* -------------------------------------------------------
   Initial state
------------------------------------------------------- */

detectMode();

</script>

