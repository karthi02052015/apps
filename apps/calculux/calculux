<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Calculux</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
body{background:#090b10;color:#f7f8fb}button,input,select{font:inherit}button{cursor:pointer}
.app{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:240px;background:#0d1016;border-right:1px solid #272d38;padding:22px 14px;z-index:20}
.logo{font-size:23px;font-weight:800;padding:0 10px 24px}.logo span{color:#7c6cff;font-size:29px;margin-right:7px}
.section{font-size:10px;color:#687181;letter-spacing:.14em;font-weight:800;padding:14px 10px 7px}
.nav button{display:block;width:100%;border:0;background:transparent;color:#9ba2b1;text-align:left;border-radius:9px;padding:10px;margin:2px 0}.nav button:hover{background:#191d27;color:#fff}.nav button.active{background:#28233f;color:#c5bfff}
main{margin-left:240px;padding:30px;min-height:100vh;max-width:1450px}.page{display:none}.page.active{display:block}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}.header h1{font-size:28px;margin:0}.actions{display:flex;gap:8px}
.btn{border:1px solid #292f3a;background:#151922;color:#fff;border-radius:9px;padding:9px 13px}.primary{background:#f5f6fa;color:#11141a;border-color:#f5f6fa;font-weight:750}
.hero h2{font-size:34px;margin:0 0 5px}.hero p{color:#9299a8;margin:0 0 20px}.search{width:100%;height:58px;padding:0 18px;background:#12151c;border:1px solid #292f3a;border-radius:12px;color:#fff;outline:0}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:27px}.quick{min-height:130px;text-align:left;padding:18px;border:1px solid #292f3a;border-radius:14px;background:#12151c;color:#fff}.quick:hover{border-color:#504b72;transform:translateY(-1px)}.quick .ico{font-size:23px;margin-bottom:15px}.quick strong{display:block}.quick small{display:block;color:#9299a8;margin-top:5px}
.page-head{display:flex;align-items:center;gap:12px;margin-bottom:15px}.back{border:0;background:transparent;color:#bdb7ff;font-weight:750;padding:7px 0}.page-title{font-size:27px;font-weight:800}.card{max-width:980px;background:#12151c;border:1px solid #292f3a;border-radius:15px;padding:18px}.sub{color:#9299a8;font-size:12px;margin-bottom:15px}
.display{background:#080a0e;border:1px solid #20242c;border-radius:12px;padding:14px;text-align:right;min-height:92px;margin-bottom:12px}.display .expr{font-size:13px;color:#808899;min-height:20px}.display .result{font-size:32px;font-weight:800;word-break:break-all}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.keys button{min-height:57px;border:0;border-radius:10px;background:#20242d;color:#fff}.keys button:hover{background:#2b303a}.keys .op{background:#292544;color:#c2bcff}.keys .eq{background:#7c6cff}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form{display:grid;gap:10px}label{font-size:11px;color:#9299a8;display:block;margin-bottom:5px}
input,select,textarea{width:100%;padding:11px;border:1px solid #292f3a;border-radius:9px;background:#171b24;color:#fff;outline:0}input:focus,select:focus,textarea:focus{border-color:#7c6cff}
.action{width:100%;border:0;border-radius:9px;background:#7c6cff;color:#fff;padding:12px;font-weight:750}.out{margin-top:11px;padding:12px;background:#1a1f28;border:1px solid #292f3a;border-radius:9px;line-height:1.6;min-height:44px}
.sci-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-top:12px}.sci-grid button{padding:10px 4px;background:#20242d;color:#fff;border:0;border-radius:8px}.sci-grid button:hover{background:#2b303a}
.graph{height:310px;background:#080a0e;border:1px solid #292f3a;border-radius:10px;margin-top:12px}.graph canvas{width:100%;height:100%}
.mobile-nav{display:none}
@media(max-width:1000px){.quick-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){
 body{padding-bottom:78px}.sidebar{position:sticky;inset:auto;width:100%;height:auto;padding:11px 13px;background:#0d1016;border-right:0;border-bottom:1px solid #272d38}.logo{padding:0 3px 8px;font-size:20px}.sidebar .section,.sidebar .nav{display:none}
 main{margin:0;padding:17px 12px 28px}.header h1{font-size:22px}.hero h2{font-size:28px}.hero p{font-size:13px}.search{height:53px;font-size:16px}
 .quick-grid{gap:9px;margin-top:17px}.quick{min-height:105px;padding:13px}.quick .ico{margin-bottom:9px}.quick small{font-size:10px}
 .card{padding:13px;border-radius:13px}.page-title{font-size:21px}.row{grid-template-columns:1fr}.keys{gap:6px}.keys button{min-height:57px;font-size:17px}.sci-grid{grid-template-columns:repeat(4,1fr)}
 .mobile-nav{display:flex;position:fixed;left:8px;right:8px;bottom:8px;height:64px;z-index:100;background:#12151cf5;border:1px solid #292f3a;border-radius:17px;padding:5px;backdrop-filter:blur(15px)}
 .mobile-nav button{flex:1;background:transparent;border:0;color:#9299a8;border-radius:12px;font-size:10px}.mobile-nav span{display:block;font-size:20px;line-height:22px}.mobile-nav button.active{background:#28233f;color:#c5bfff}
}

body.light{background:#f5f6fa;color:#151821}
body.light .sidebar{background:#fff;border-color:#e3e5eb}
body.light .nav button{color:#626978}body.light .nav button.active{background:#eeeaff;color:#554bdc}
body.light .card,body.light .quick,body.light .search,body.light .btn{background:#fff;color:#151821;border-color:#e3e5eb}
body.light .quick small,body.light .sub,body.light .hero p{color:#707786}
body.light input,body.light select,body.light textarea{background:#fafbfe;color:#151821;border-color:#e3e5eb}
body.light .out{background:#f0f1f5;border-color:#e3e5eb}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
<div class="logo"><span>∑</span>Calculux</div>
<div class="section">WORKSPACE</div>
<nav class="nav">
<button data-page="home">⌂ Home</button>
<button data-page="calculator">▣ Calculator</button>
<button data-page="scientific">◈ Scientific</button>
<button data-page="graph">⌁ Graph</button>
<button data-page="finance">₹ Finance</button>
<button data-page="converter">⇄ Converter</button>
<button data-page="statistics">Σ Statistics</button>
<button data-page="engineering">⚙ Engineering</button>
<button data-page="programmer">01 Programmer</button>
<button data-page="date">◷ Date & Time</button>
</nav>
<div class="section">TOOLS</div>
<nav class="nav"><button data-page="bmi">⚖ BMI Calculator</button></nav>
</aside>

<main>
<!-- HOME ONLY -->
<section class="page active" id="home">
<div class="header"><h1>Home</h1><div class="actions"><button class="btn" id="theme">☾</button><button class="btn primary" data-page="calculator">Calculate</button></div></div>
<div class="hero"><h2>Good morning 👋</h2><p>Every calculation. One beautiful workspace.</p><input class="search" id="search" placeholder="Search calculators or type an expression e.g. 15% of 2400"></div>
<div class="quick-grid">
<button class="quick" data-page="scientific"><div class="ico">◈</div><strong>Scientific</strong><small>Advanced math & trigonometry</small></button>
<button class="quick" data-page="emi"><div class="ico">₹</div><strong>EMI</strong><small>Loans, investments & GST</small></button>
<button class="quick" data-page="converter"><div class="ico">⇄</div><strong>Converter</strong><small>Length, weight, temperature</small></button>
<button class="quick" data-page="statistics"><div class="ico">Σ</div><strong>Statistics</strong><small>Analyze any dataset</small></button>
</div>
</section>

<!-- CALCULATOR -->
<section class="page" id="calculator"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Calculator</div></div><div class="card">
<div class="sub">Everyday calculator</div><div class="display"><div id="ce" class="expr">0</div><div id="cr" class="result">0</div></div>
<div class="keys">
<button data-k="AC">AC</button><button data-k="DEL">DEL</button><button class="op" data-k="%">%</button><button class="op" data-k="/">÷</button>
<button data-k="7">7</button><button data-k="8">8</button><button data-k="9">9</button><button class="op" data-k="*">×</button>
<button data-k="4">4</button><button data-k="5">5</button><button data-k="6">6</button><button class="op" data-k="-">−</button>
<button data-k="1">1</button><button data-k="2">2</button><button data-k="3">3</button><button class="op" data-k="+">+</button>
<button data-k="(">(</button><button data-k="0">0</button><button data-k=".">.</button><button class="eq" data-k="=">=</button>
</div></div></section>

<!-- FULL SCIENTIFIC -->
<section class="page" id="scientific"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Scientific Calculator</div></div><div class="card">
<div class="sub">A complete scientific function calculator — trigonometry, inverse trig, logs, powers, roots, constants and more.</div>
<div class="row"><input id="sx" placeholder="Enter expression, e.g. sin(30)+sqrt(25)"><select id="sunit"><option>Degrees</option><option>Radians</option></select></div>
<div class="sci-grid">
<button data-sci="sin(">sin</button><button data-sci="cos(">cos</button><button data-sci="tan(">tan</button><button data-sci="asin(">asin</button><button data-sci="acos(">acos</button><button data-sci="atan(">atan</button>
<button data-sci="sinh(">sinh</button><button data-sci="cosh(">cosh</button><button data-sci="tanh(">tanh</button><button data-sci="sqrt(">√</button><button data-sci="cbrt(">∛</button><button data-sci="abs(">abs</button>
<button data-sci="log(">log</button><button data-sci="ln(">ln</button><button data-sci="exp(">eˣ</button><button data-sci="^2">x²</button><button data-sci="^">xʸ</button><button data-sci="!">x!</button>
<button data-sci="π">π</button><button data-sci="e">e</button><button data-sci="(">(</button><button data-sci=")">)</button><button data-sci=",">,</button><button data-sci="%">%</button>
</div>
<br><button class="action" id="scalc">Calculate</button><div class="out" id="sout">—</div>
</div></section>

<section class="page" id="graph"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Graphing Calculator</div></div><div class="card"><div class="sub">Plot mathematical functions of x.</div><div class="row"><input id="gx" value="x*x" placeholder="x*x, sin(x), 2*x+1"><button class="action" id="gplot">Plot</button></div><div class="graph"><canvas id="gc"></canvas></div></div></section>

<section class="page" id="finance"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Finance</div></div><div class="card"><div class="sub">GST and discount calculator</div><div><label>Price ₹</label><input id="fp" type="number"></div><div class="row"><div><label>GST %</label><input id="fg" type="number" value="18"></div><div><label>Discount %</label><input id="fd" type="number" value="10"></div></div><button class="action" id="fgo">Calculate</button><div class="out" id="fout">—</div></div></section>

<section class="page" id="emi"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">EMI Calculator</div></div><div class="card"><div class="sub">Loan monthly payment</div><div class="row"><div><label>Principal ₹</label><input id="ep" type="number"></div><div><label>Annual interest %</label><input id="er" type="number" step=".01"></div></div><label>Tenure years</label><input id="ey" type="number"><button class="action" id="ego">Calculate EMI</button><div class="out" id="eout">—</div></div></section>

<section class="page" id="converter"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Converter</div></div><div class="card"><div class="sub">Length, weight and temperature</div><select id="cc"><option value="length">Length</option><option value="weight">Weight</option><option value="temp">Temperature</option></select><div class="row"><input id="cv" type="number" placeholder="Value"><select id="cf"></select></div><div class="row"><select id="ct"></select><button class="action" id="cgo">Convert</button></div><div class="out" id="cout">—</div></div></section>

<section class="page" id="statistics"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Statistics</div></div><div class="card"><div class="sub">Mean, median, minimum, maximum and sum.</div><textarea id="sd" rows="7" style="width:100%" placeholder="12, 15, 18...">12,15,18,20,25,31</textarea><button class="action" id="sgo">Analyze</button><div class="out" id="sout2">—</div></div></section>

<section class="page" id="engineering"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Engineering</div></div><div class="card"><div class="sub">Ohm's law and circle calculations.</div><div class="row"><input id="ov" type="number" placeholder="Voltage V"><input id="or" type="number" placeholder="Resistance Ω"></div><button class="action" id="ogo">Calculate Current</button><div class="out" id="oout">—</div><br><div class="row"><input id="rad" type="number" placeholder="Radius"><button class="action" id="rgo">Calculate Circle</button></div><div class="out" id="rout">—</div></div></section>

<section class="page" id="programmer"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Programmer</div></div><div class="card"><div class="sub">Decimal, binary, octal and hexadecimal.</div><input id="pd" type="number" placeholder="Decimal"><button class="action" id="pgo">Convert</button><div class="out" id="pout">—</div></div></section>

<section class="page" id="date"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">Date & Time</div></div><div class="card"><div class="sub">Difference between two dates.</div><div class="row"><input id="d1" type="date"><input id="d2" type="date"></div><button class="action" id="dgo">Calculate Difference</button><div class="out" id="dout">—</div></div></section>

<section class="page" id="bmi"><div class="page-head"><button class="back" data-page="home">← Home</button><div class="page-title">BMI Calculator</div></div><div class="card"><div class="sub">Body Mass Index</div><div class="row"><input id="bw" type="number" placeholder="Weight kg"><input id="bh" type="number" placeholder="Height cm"></div><button class="action" id="bgo">Calculate BMI</button><div class="out" id="bout">—</div></div></section>
</main>
</div>

<nav class="mobile-nav"><button data-page="home"><span>⌂</span>Home</button><button data-page="calculator"><span>▣</span>Calc</button><button data-page="scientific"><span>◈</span>Scientific</button><button data-page="converter"><span>⇄</span>Convert</button><button data-page="bmi"><span>⚖</span>BMI</button></nav>

<script>
"use strict";
const $=id=>document.getElementById(id);
function go(id){document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));$(id).classList.add("active");document.querySelectorAll("[data-page]").forEach(b=>b.classList.toggle("active",b.dataset.page===id));window.scrollTo({top:0,behavior:"smooth"});if(id==="graph")setTimeout(plot,100)}
document.querySelectorAll("[data-page]").forEach(b=>b.addEventListener("click",()=>go(b.dataset.page)));
$("theme").addEventListener("click",()=>document.body.classList.toggle("light"));

let ce="";
function render(v=ce||"0"){$("ce").textContent=ce||"0";$("cr").textContent=v}
function calc(s){if(!/^[0-9+\-*/().%\s]+$/.test(s))throw Error();return Function('"use strict";return ('+s.replace(/(\d+(?:\.\d+)?)%/g,"($1/100)")+')')()}
document.querySelectorAll("[data-k]").forEach(b=>b.addEventListener("click",()=>{let k=b.dataset.k;if(k==="AC"){ce="";render();return}if(k==="DEL"){ce=ce.slice(0,-1);render();return}if(k==="="){try{ce=String(calc(ce));render(ce)}catch{render("Error")}return}ce+=k;render()}));

function factorial(n){if(n<0||n>170||n%1)return NaN;let r=1;for(let i=2;i<=n;i++)r*=i;return r}
document.querySelectorAll("[data-sci]").forEach(b=>b.addEventListener("click",()=>{$("sx").value+=b.dataset.sci}));
$("scalc").addEventListener("click",()=>{
 try{
  let x=$("sx").value.trim().toLowerCase().replaceAll("π","Math.PI").replaceAll("sqrt","Math.sqrt").replaceAll("cbrt","Math.cbrt").replaceAll("abs","Math.abs").replaceAll("log","Math.log10").replaceAll("ln","Math.log").replaceAll("exp","Math.exp").replaceAll("^","**").replace(/\be\b/g,"Math.E");
  x=x.replace(/\bpi\b/g,"Math.PI");
  ["sin","cos","tan","asin","acos","atan","sinh","cosh","tanh"].forEach(f=>x=x.replaceAll(f+"(","Math."+f+"("));
  if($("sunit").value==="Degrees")x=x.replace(/Math\.(sin|cos|tan|asin|acos|atan)\(([^()]*)\)/g,(m,f,n)=>`Math.${f}(((${n})*Math.PI/180))`);
  x=x.replace(/(\d+(?:\.\d+)?)!/g,"factorial($1)");
  if(!/^[0-9A-Za-z_+*\/().,\-\s]+$/.test(x))throw Error();
  let v=Function("factorial","return "+x)(factorial);$("sout").textContent=Number.isFinite(v)?v:"Error";
 }catch{$("sout").textContent="Invalid expression"}
});

$("search").addEventListener("keydown",e=>{if(e.key!=="Enter")return;let q=e.target.value.trim().toLowerCase();let m=q.match(/^([\d.]+)%\s*of\s*([\d.]+)$/);if(m){go("calculator");ce=String(+m[1]/100*+m[2]);render(ce);return}let b=[...document.querySelectorAll(".quick")].find(x=>x.innerText.toLowerCase().includes(q));if(b)go(b.dataset.page)});

$("fgo").addEventListener("click",()=>{let p=+$("fp").value,g=+$("fg").value,d=+$("fd").value;if(!p){$("fout").textContent="Enter price";return}let a=p*(1-d/100),t=a*g/100;$("fout").innerHTML=`After discount: ₹${a.toFixed(2)}<br>GST: ₹${t.toFixed(2)}<br>Final price: ₹${(a+t).toFixed(2)}`});
$("ego").addEventListener("click",()=>{let p=+$("ep").value,r=+$("er").value/1200,n=+$("ey").value*12;if(!p||!n){$("eout").textContent="Enter values";return}let m=r?p*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):p/n;$("eout").innerHTML=`Monthly EMI: ₹${m.toFixed(2)}<br>Total payment: ₹${(m*n).toFixed(2)}<br>Total interest: ₹${(m*n-p).toFixed(2)}`});

const units={length:{m:1,km:1000,cm:.01,mm:.001,ft:.3048,in:.0254},weight:{kg:1,g:.001,lb:.453592,oz:.0283495},temp:{C:1,F:1,K:1}};
function fillUnits(){let a=Object.keys(units[$("cc").value]);$("cf").innerHTML=a.map(x=>`<option>${x}</option>`).join("");$("ct").innerHTML=a.map(x=>`<option>${x}</option>`).join("");if(a[1])$("ct").selectedIndex=1}
$("cc").addEventListener("change",fillUnits);fillUnits();
$("cgo").addEventListener("click",()=>{let c=$("cc").value,v=+$("cv").value,a=$("cf").value,b=$("ct").value;if(!Number.isFinite(v)){$("cout").textContent="Enter value";return}if(c==="temp"){let x=a==="C"?v:a==="F"?(v-32)*5/9:v-273.15;let y=b==="C"?x:b==="F"?x*9/5+32:x+273.15;$("cout").textContent=y.toFixed(6)}else $("cout").textContent=(v*units[c][a]/units[c][b]).toFixed(8)});

$("sgo").addEventListener("click",()=>{let a=$("sd").value.split(/[\s,]+/).map(Number).filter(Number.isFinite).sort((x,y)=>x-y);if(!a.length){$("sout2").textContent="No numbers";return}let sum=a.reduce((x,y)=>x+y,0),mean=sum/a.length,med=a.length%2?a[(a.length-1)/2]:(a[a.length/2-1]+a[a.length/2])/2;$("sout2").innerHTML=`Count: ${a.length}<br>Sum: ${sum}<br>Mean: ${mean.toFixed(4)}<br>Median: ${med}<br>Min: ${a[0]}<br>Max: ${a.at(-1)}`});
$("ogo").addEventListener("click",()=>{let v=+$("ov").value,r=+$("or").value;$("oout").textContent=v&&r?`Current = ${(v/r).toFixed(4)} A`:"Enter voltage and resistance"});
$("rgo").addEventListener("click",()=>{let r=+$("rad").value;$("rout").textContent=r>0?`Area = ${(Math.PI*r*r).toFixed(4)} | Circumference = ${(2*Math.PI*r).toFixed(4)}`:"Enter radius"});
$("pgo").addEventListener("click",()=>{let n=+$("pd").value;if(!Number.isFinite(n)){$("pout").textContent="Enter number";return}n=Math.trunc(n);$("pout").innerHTML=`Binary: ${n.toString(2)}<br>Octal: ${n.toString(8)}<br>Hexadecimal: ${n.toString(16).toUpperCase()}`});
$("dgo").addEventListener("click",()=>{let a=new Date($("d1").value),b=new Date($("d2").value);$("dout").textContent=isNaN(a)||isNaN(b)?"Choose both dates":Math.abs(Math.round((b-a)/86400000))+" days"});
$("bgo").addEventListener("click",()=>{let w=+$("bw").value,h=+$("bh").value/100;if(!w||!h){$("bout").textContent="Enter weight and height";return}let x=w/(h*h);$("bout").textContent=`BMI: ${x.toFixed(1)} — ${x<18.5?"Underweight":x<25?"Normal":x<30?"Overweight":"Obesity"}`});

function plot(){let c=$("gc"),box=c.parentElement,r=box.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;let ctx=c.getContext("2d");ctx.setTransform(d,0,0,d,0,0);let w=r.width,h=r.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle="#2b303a";ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.moveTo(w/2,0);ctx.lineTo(w/2,h);ctx.stroke();let ex=$("gx").value.replace(/\^/g,"**").replace(/\bsin\b/g,"Math.sin").replace(/\bcos\b/g,"Math.cos").replace(/\btan\b/g,"Math.tan").replace(/\bsqrt\b/g,"Math.sqrt");ctx.strokeStyle="#7c6cff";ctx.lineWidth=2;ctx.beginPath();let started=false;for(let px=0;px<w;px++){let x=(px-w/2)/25,y;try{y=Function("x","return "+ex)(x)}catch{return}let py=h/2-y*25;if(!Number.isFinite(py)||Math.abs(py)>10000){started=false;continue}if(!started){ctx.moveTo(px,py);started=true}else ctx.lineTo(px,py)}ctx.stroke()}
$("gplot").addEventListener("click",plot);window.addEventListener("resize",()=>{$("graph").classList.contains("active")&&plot()});
</script>
</body>
</html>
